# HTTP Basic Auth gate for the deployed site (see middleware.ts).
# Set these as real Environment Variables in the Vercel project settings
# (Project -> Settings -> Environment Variables) — never commit actual
# values. Not used in local `npm run dev` (middleware.ts only runs on
# Vercel's deployed edge, not the Vite dev server).
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Cloud backup sync (see api/sync.ts, src/lib/cloudSync.ts). Not a value
# you type in — create/connect a Blob store in the Vercel dashboard
# (Project -> Storage -> Create Database -> Blob) and it auto-provisions
# this for you. Only works on the deployed app; there's no local dev
# mirror for it (unlike /api/adp), since it inherently needs a live
# store/token, not just a CORS workaround.
BLOB_READ_WRITE_TOKEN=
